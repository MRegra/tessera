<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.sobatista.tessera</groupId>
  <artifactId>tessera-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Tessera</name>
  <description>End-to-end encrypted shared photo albums where the server never holds a photo — each member keeps their own slice in their own storage, the server only knows who is in which album. Album keys wrapped per member, signed encrypted catalogs, and key rotation when a member leaves.</description>
  <url>https://github.com/MRegra/tessera</url>
  <licenses>
    <license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license>
  </licenses>
  <modules>
    <module>tessera-core</module>
    <module>tessera-server</module>
    <module>tessera-cli</module>
  </modules>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <jackson.version>2.21.7</jackson.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId><artifactId>junit-bom</artifactId>
        <version>${junit.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.sobatista.tessera</groupId><artifactId>tessera-core</artifactId><version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>dev.sobatista.tessera</groupId><artifactId>tessera-server</artifactId><version>0.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
